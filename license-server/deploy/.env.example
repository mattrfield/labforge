# Copy to .env and edit. .env is gitignored.

# The domain that points at this server, e.g. license.example.com
LICENSE_DOMAIN=license.example.com

# Gumroad product ID: the product's Content tab, under the License key block.
GUMROAD_PRODUCT_ID=824xmnktJz3BlTTrw_395g==

# How long a license token lasts before the launcher renews it (seconds). 1209600 = 14 days.
# A refund stops new pro downloads at the next renewal, so shorter means faster revocation.
TOKEN_TTL_SECS=1209600
