{$LICENSE_DOMAIN} {
	# Caddy gets a certificate for the domain by itself and renews it.
	# Requests here are tiny JSON bodies and GETs; cap anything else.
	request_body {
		max_size 8KB
	}

	reverse_proxy license:8787

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
