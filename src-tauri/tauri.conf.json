{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabForge",
  "mainBinaryName": "labforge",
  "version": "0.1.1",
  "identifier": "dev.labforge.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LabForge",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMUFEMTk1RjU5MDZENEMKUldSTWJaRDFsZEVhZjNXZlh3ZjdzM0pOQUNVRlc4bS84aEdxaXJwQXdZZDM2V2tQeEt2Q3o0TCsK",
      "endpoints": ["https://github.com/mattrfield/labforge/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../labs/": "labs/"
    },
    "category": "Education",
    "shortDescription": "Local, hands-on cybersecurity labs"
  }
}
